# Registry persistence (JSON file store). Leave unset for in-memory.
MLPLATFORM_REGISTRY_PATH=./data/registry.json
# Monitoring thresholds (defaults shown)
MLPLATFORM_PSI_WARN=0.10
MLPLATFORM_PSI_CRITICAL=0.25
MLPLATFORM_DI_MIN=0.80
MLPLATFORM_ROLLBACK_CONSECUTIVE_CRITICAL=2
# API
MLPLATFORM_API_HOST=0.0.0.0
MLPLATFORM_API_PORT=8080
